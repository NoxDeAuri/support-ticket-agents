# Default provider is Ollama (free, local) — no key needed, this file
# is only relevant if you switch providers.

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here

# Optional overrides (defaults shown):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1
